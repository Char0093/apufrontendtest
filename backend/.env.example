# Copy to .env and fill in real values. Never commit the real .env file.

# Required — no safe default, app fails to boot without it.
GEMINI_API_KEY=your-gemini-api-key-here

# Neo4j (knowledge graph). Password is required — no safe default.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password-here

# Redis (Celery broker/backend)
REDIS_URL=redis://localhost:6379/0

# Metadata store (meetings, task records)
DATABASE_URL=sqlite:///./corporate_brain.db

# Filesystem root for raw/audio/transcripts/summaries/exports artifacts
STORAGE_PATH=storage

# LiveKit: values below are only for `livekit-server --dev`.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
