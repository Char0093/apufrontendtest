# Copy to .env and fill in real values. Never commit the real .env file.

# Optional in demo mode. Leave blank to prevent API usage.
GEMINI_API_KEY=

# Vertex AI service-account authentication. For local development, set the
# file path. For Hugging Face Spaces, add the compact JSON document as the
# private GEMINI_SERVICE_ACCOUNT_JSON secret instead of using a file path.
GEMINI_SERVICE_ACCOUNT_FILE=
GEMINI_SERVICE_ACCOUNT_JSON=
GEMINI_PROJECT_ID=apu-fintech-hackathon
GEMINI_LOCATION=us-central1
GEMINI_VERTEX_MODEL=gemini-2.5-flash

# Neo4j (knowledge graph). Password is required — no safe default.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password-here

# Redis (Celery broker/backend)
REDIS_URL=redis://localhost:6379/0

# Metadata store (meetings, task records)
DATABASE_URL=sqlite:///./corporate_brain.db

# Filesystem root for raw/audio/transcripts/summaries/exports artifacts
STORAGE_PATH=storage

# Transcription (Deepgram nova-2, transcribes + diarizes in one call)
DEEPGRAM_API_KEY=

# Gemini fallback + Ask Coco vision fallback (optional — leave blank to disable)
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# Ask Coco uses predefined Neo4j queries and does not need an LLM key.
GROQ_API_KEY=

# true = run the full pipeline on canned demo data, no API keys required
DEMO_MODE=true

# ChromaDB persistence path (real-mode contradiction-detection embeddings)
CHROMA_PATH=storage/chroma

# LiveKit: values below are only for `livekit-server --dev`.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
