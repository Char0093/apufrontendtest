# Used by `docker compose up` for ${VAR} substitution in docker-compose.yml.
# Copy to .env (repo root) and fill in real values. Never commit the real one.
#
# This is separate from backend/.env.example — that one is for running the
# backend directly (cd backend && uvicorn app.main:app). If you use both
# workflows, keep the two files' values in sync.

GEMINI_API_KEY=your-gemini-api-key-here
NEO4J_PASSWORD=your-neo4j-password-here
