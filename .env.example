# Copy to .env and fill in real values. Never commit the real .env file.

# Required — no safe default, app fails to boot without it.
GEMINI_API_KEY=your-gemini-api-key-here

# Neo4j (knowledge graph). Password is required — no safe default.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password-here

# ASR model size: tiny | base | small | medium | large-v3
WHISPER_MODEL_SIZE=base

# Redis (Celery broker/backend)
REDIS_URL=redis://localhost:6379/0

# Filesystem root for raw/audio/transcripts/summaries artifacts
STORAGE_BASE_PATH=storage

# SQLite metadata store (meetings, task records)
SQLITE_URL=sqlite:///./corporate_brain.db
