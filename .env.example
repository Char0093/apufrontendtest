# Used by `docker compose up` for ${VAR} substitution in docker-compose.yml.
# Copy to .env (repo root) and fill in real values. Never commit the real one.
#
# This is separate from backend/.env.example — that one is for running the
# backend directly (cd backend && uvicorn app.main:app). If you use both
# workflows, keep the two files' values in sync.

GEMINI_API_KEY=
NEO4J_PASSWORD=your-neo4j-password-here
DEEPGRAM_API_KEY=
AGNES_API_KEY=
GROQ_API_KEY=
DEMO_MODE=true

# Google OAuth. Use the same web client id for backend verification and
# frontend Google Identity Services.
GOOGLE_OAUTH_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# App JWT signing secret used after Google OAuth verification.
APP_JWT_SECRET=replace-with-a-long-random-secret
APP_JWT_ISSUER=corporate-brain
APP_JWT_EXP_MINUTES=480

# LiveKit credentials used by the FastAPI service. These dev values match
# `livekit-server --dev`; replace them before any shared deployment.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
